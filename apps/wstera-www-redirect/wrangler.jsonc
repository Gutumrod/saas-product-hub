{
  "$schema": "../../apps/hub-web/node_modules/wrangler/config-schema.json",
  "name": "wstera-www-redirect",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "www.wstera.com",
